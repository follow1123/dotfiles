font-family = "CaskaydiaCove Nerd Font Mono"
theme = Dark+
font-size = 11
font-feature = "-calt, -liga, -dlig"

copy-on-select = clipboard
window-padding-x = 0
window-padding-y = 0
background-opacity = 0.9
window-padding-balance = true

window-decoration = false
gtk-adwaita = false
gtk-wide-tabs = false
cursor-style = bar

mouse-hide-while-typing = true


keybind = ctrl+t=new_tab
keybind = alt+w>v=new_split:right
keybind = alt+w>alt+v=new_split:right
keybind = alt+w>s=new_split:down
keybind = alt+w>alt+s=new_split:down

keybind = alt+w>z=toggle_split_zoom
keybind = alt+w>h=goto_split:left
keybind = alt+w>alt+h=goto_split:left
keybind = alt+w>l=goto_split:right
keybind = alt+w>alt+l=goto_split:right
keybind = alt+w>j=goto_split:bottom
keybind = alt+w>alt+j=goto_split:bottom
keybind = alt+w>k=goto_split:top
keybind = alt+w>alt+k=goto_split:top

keybind = ctrl+;=next_tab
keybind = ctrl+,=previous_tab

# keybind = ctrl+;=unbind
# keybind = ctrl+,=unbind

# unbind keybinds
keybind = ctrl+enter=ignore
# 发送 esc 键
keybind = ctrl+[=text:\x1b
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
